# Public hostname only, without https:// or a trailing slash.
# A real domain is best. For testing, PUBLIC_IP.sslip.io also works.
DOMAIN=blog.example.com

APP_ENV=production
APP_PORT=8080
CLIENT_ORIGIN=https://blog.example.com

# MongoDB Atlas base URI. Credentials are inserted and URL-encoded by the app.
MONGO_URI=mongodb+srv://cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_USERNAME=lumina_production
MONGO_PASSWORD=replace-with-atlas-password
MONGO_DATABASE=lumina

JWT_SECRET=replace-with-output-of-openssl-rand-base64-64
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=168h

STORAGE_TYPE=cloudinary
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Leave these empty after the first production admin has been created.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

