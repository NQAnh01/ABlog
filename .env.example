# development | production
APP_ENV=development
APP_PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# Docker Compose: mongodb://mongodb:27017
# Go chạy trực tiếp trên host: mongodb://localhost:27017
# MongoDB Atlas: URI base có thể không chứa credentials; backend sẽ chèn hai
# biến bên dưới và tự URL-encode ký tự đặc biệt.
MONGO_URI=mongodb://mongodb:27017
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_DATABASE=lumina

# Tạo bằng: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=168h

STORAGE_TYPE=local
STORAGE_PATH=uploads

# Optional development seed. Leave unset in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=development-password
